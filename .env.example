# Vercel Environment Variables — শুধু নাম, কোনো আসল মান এখানে না।
# আসল মান শুধু Vercel Dashboard → Settings → Environment Variables-এ বসবে।

# Browser-এ পৌঁছায় (NEXT_PUBLIC_ prefix আবশ্যক) — anon key, RLS দিয়ে সুরক্ষিত, পাবলিক-সেফ
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# শুধু সার্ভার-সাইড, browser কখনো দেখে না
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
GOOGLE_SHEET_URL=
